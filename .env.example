# AWS local profile created through `aws login`
AWS_PROFILE=safeeats-dev
AWS_REGION=us-east-1

# Phase 2 Bronze storage (the bucket must already exist and remain private)
SAFEEATS_S3_BUCKET=
SAFEEATS_S3_PREFIX=bronze
SAFEEATS_SILVER_PREFIX=silver
SAFEEATS_STORAGE_BACKEND=s3

# Phase 4 Athena and dbt resources
ATHENA_SILVER_DATABASE=safeeats_silver
ATHENA_DBT_SCHEMA=safeeats_gold
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=

# Optional NYC Open Data application token
NYC_OPEN_DATA_APP_TOKEN=

# Phase 2 ingestion defaults
SAFEEATS_PROJECT_ROOT=
SAFEEATS_BRONZE_ROOT=
SAFEEATS_AUDIT_DB=
SAFEEATS_INGESTION_PAGE_SIZE=10000
SAFEEATS_OVERLAP_DAYS=2
SAFEEATS_INITIAL_LOOKBACK_DAYS=1095

# Local Airflow development settings
AIRFLOW_VERSION=3.3.1
AIRFLOW_UID=50000
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_JWT_SECRET=replace-for-any-shared-environment

# Phase 7 local website
SAFEEATS_API_PORT=8000
SAFEEATS_FRONTEND_PORT=3000
SAFEEATS_FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
RISK_SCORE_RUN_ID=current-risk-scores-20260906-v1
RISK_SCORE_POINTER_KEY=ml/current_scores/latest.json
ATHENA_QUERY_TIMEOUT_SECONDS=90
API_CACHE_TTL_SECONDS=300
